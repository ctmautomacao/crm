generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── MULTI-TENANT ────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  nome      String
  slug      String   @unique
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  vendedores          Vendedor[]
  clientes            Cliente[]
  fornecedores        Fornecedor[]
  produtos            Produto[]
  marcas              Marca[]
  categorias          Categoria[]
  formasPagamento     FormaPagamento[]
  origensLead         OrigemLead[]
  campanhas           Campanha[]
  indicadores         Indicador[]
  gruposProduto       GrupoProduto[]
  motivosEncerramento MotivoEncerramento[]
  tiposOportunidade   TipoOportunidade[]
  statusOportunidade  StatusOportunidade[]
  configuracoesAlerta ConfiguracaoAlerta[]
  leads               Lead[]
  feedLeads           FeedLead[]
  oportunidades       Oportunidade[]
  cotacoes            Cotacao[]
  propostas           Proposta[]
  pedidos             Pedido[]

  @@map("tenants")
}

// ─── USUÁRIOS ─────────────────────────────────────────────────────────────────

model Vendedor {
  id           String   @id @default(cuid())
  tenantId     String
  nome         String
  email        String
  senhaHash    String
  perfil       Perfil   @default(VENDEDOR)
  codigoVendedor String?
  comissaoPct  Float    @default(5)
  ativo        Boolean  @default(true)
  sistema      Boolean  @default(false) // admin padrão do sistema, não pode ser deletado
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  leads        Lead[]   @relation("LeadVendedor")
  oportunidades Oportunidade[] @relation("OportunidadeVendedor")
  feedLeads    FeedLead[]
  cotacoes     Cotacao[]
  propostas    Proposta[]
  pedidos      Pedido[]

  @@unique([tenantId, email])
  @@map("vendedores")
}

enum Perfil {
  GERENTE
  VENDEDOR
}

// ─── CONFIGURAÇÕES ────────────────────────────────────────────────────────────

model ConfiguracaoAlerta {
  id       String         @id @default(cuid())
  tenantId String
  entidade EntidadeAlerta
  nivel    NivelAlerta
  dias     Int
  cor      String         // hex color
  ativo    Boolean        @default(true)

  tenant   Tenant         @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, entidade, nivel])
  @@map("configuracoes_alerta")
}

enum EntidadeAlerta {
  LEAD
  OPORTUNIDADE
}

enum NivelAlerta {
  ATENCAO
  CRITICO
}

// ─── TABELAS DE APOIO ─────────────────────────────────────────────────────────

model OrigemLead {
  id       String @id @default(cuid())
  tenantId String
  nome     String
  ativo    Boolean @default(true)

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  leads    Lead[]

  @@unique([tenantId, nome])
  @@map("origens_lead")
}

model Campanha {
  id       String @id @default(cuid())
  tenantId String
  nome     String
  ativo    Boolean @default(true)

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  leads    Lead[]

  @@unique([tenantId, nome])
  @@map("campanhas")
}

model Indicador {
  id       String @id @default(cuid())
  tenantId String
  nome     String
  email    String?
  ativo    Boolean @default(true)

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  leads    Lead[]

  @@unique([tenantId, nome])
  @@map("indicadores")
}

model GrupoProduto {
  id       String @id @default(cuid())
  tenantId String
  nome     String
  ativo    Boolean @default(true)

  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, nome])
  @@map("grupos_produto")
}

model MotivoEncerramento {
  id       String @id @default(cuid())
  tenantId String
  nome     String
  ativo    Boolean @default(true)

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  oportunidades Oportunidade[]

  @@unique([tenantId, nome])
  @@map("motivos_encerramento")
}

model TipoOportunidade {
  id       String @id @default(cuid())
  tenantId String
  nome     String
  ativo    Boolean @default(true)

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  oportunidades Oportunidade[]

  @@unique([tenantId, nome])
  @@map("tipos_oportunidade")
}

model StatusOportunidade {
  id       String @id @default(cuid())
  tenantId String
  nome     String
  ordem    Int    @default(0)
  ativo    Boolean @default(true)

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  oportunidades Oportunidade[]

  @@unique([tenantId, nome])
  @@map("status_oportunidade")
}

model FormaPagamento {
  id       String @id @default(cuid())
  tenantId String
  nome     String
  ativo    Boolean @default(true)

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  propostas Proposta[]
  pedidos  Pedido[]

  @@unique([tenantId, nome])
  @@map("formas_pagamento")
}

model Marca {
  id       String @id @default(cuid())
  tenantId String
  nome     String
  ativo    Boolean @default(true)

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  produtos Produto[]

  @@unique([tenantId, nome])
  @@map("marcas")
}

model Categoria {
  id       String @id @default(cuid())
  tenantId String
  nome     String
  ativo    Boolean @default(true)

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  produtos Produto[]

  @@unique([tenantId, nome])
  @@map("categorias")
}

// ─── CLIENTES E FORNECEDORES ──────────────────────────────────────────────────

model Cliente {
  id         String   @id @default(cuid())
  tenantId   String
  nome       String
  documento  String?  // CPF ou CNPJ
  criadoEm  DateTime @default(now())

  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  telefones  ClienteTelefone[]
  emails     ClienteEmail[]
  enderecos  ClienteEndereco[]
  leads      Lead[]
  oportunidades Oportunidade[]

  @@map("clientes")
}

model ClienteTelefone {
  id        String  @id @default(cuid())
  clienteId String
  numero    String
  tipo      String? // celular, fixo, whatsapp

  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@map("clientes_telefones")
}

model ClienteEmail {
  id        String  @id @default(cuid())
  clienteId String
  email     String

  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@map("clientes_emails")
}

model ClienteEndereco {
  id        String  @id @default(cuid())
  clienteId String
  logradouro String?
  numero    String?
  complemento String?
  bairro    String?
  cidade    String?
  estado    String?
  cep       String?

  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@map("clientes_enderecos")
}

model Fornecedor {
  id         String   @id @default(cuid())
  tenantId   String
  nome       String
  documento  String?
  contato    String?
  email      String?
  telefone   String?
  criadoEm  DateTime @default(now())

  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  enderecos  FornecedorEndereco[]
  produtos   ProdutoFornecedor[]

  @@map("fornecedores")
}

model FornecedorEndereco {
  id          String     @id @default(cuid())
  fornecedorId String
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?
  cep         String?

  fornecedor  Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)

  @@map("fornecedores_enderecos")
}

// ─── PRODUTOS ─────────────────────────────────────────────────────────────────

model Produto {
  id          String    @id @default(cuid())
  tenantId    String
  descricao   String
  partNumber  String
  marcaId     String?
  categoriaId String?
  precoLista  Float     @default(0)
  margemBrutaPct Float  @default(20)
  indicePct   Float     @default(25)
  ativo       Boolean   @default(true)
  criadoEm   DateTime  @default(now())

  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  marca       Marca?    @relation(fields: [marcaId], references: [id])
  categoria   Categoria? @relation(fields: [categoriaId], references: [id])
  fornecedores ProdutoFornecedor[]
  itensOrcamento CotacaoItem[]
  itensProposta PropostaItem[]

  @@unique([tenantId, partNumber])
  @@map("produtos")
}

model ProdutoFornecedor {
  id          String     @id @default(cuid())
  produtoId   String
  fornecedorId String
  icmsPct     Float      @default(0)
  preçoFornecedor Float?
  principal   Boolean    @default(false)

  produto     Produto    @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  fornecedor  Fornecedor @relation(fields: [fornecedorId], references: [id])

  @@unique([produtoId, fornecedorId])
  @@map("produtos_fornecedores")
}

model HistoricoPreco {
  id        String   @id @default(cuid())
  produtoId String
  precoLista Float
  registradoEm DateTime @default(now())
  registradoPor String?

  @@map("historico_precos")
}

// ─── LEADS ────────────────────────────────────────────────────────────────────

model Lead {
  id           String      @id @default(cuid())
  tenantId     String
  vendedorId   String
  clienteId    String?     // criado/vinculado ao criar lead
  origemId     String?
  campanhaId   String?
  indicadorId  String?

  // dados básicos (caso não haja cliente ainda)
  nomeContato  String
  empresa      String?
  telefone     String?
  email        String?

  status       StatusLead  @default(NOVO)
  temperatura  Int         @default(1) // 1-5
  observacoes  String?

  oportunidadeId String?   // preenchido quando convertido

  criadoEm    DateTime    @default(now())
  atualizadoEm DateTime   @updatedAt

  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  vendedor     Vendedor    @relation("LeadVendedor", fields: [vendedorId], references: [id])
  cliente      Cliente?    @relation(fields: [clienteId], references: [id])
  origem       OrigemLead? @relation(fields: [origemId], references: [id])
  campanha     Campanha?   @relation(fields: [campanhaId], references: [id])
  indicador    Indicador?  @relation(fields: [indicadorId], references: [id])
  oportunidade Oportunidade? @relation(fields: [oportunidadeId], references: [id])
  feed         FeedLead[]

  @@map("leads")
}

enum StatusLead {
  NOVO
  CONTATO_REALIZADO
  EM_NEGOCIACAO
  CONVERTIDO
  PERDIDO
  DESCARTADO
}

// ─── FEED (IMUTÁVEL) ──────────────────────────────────────────────────────────

model FeedLead {
  id            String      @id @default(cuid())
  tenantId      String
  leadId        String
  oportunidadeId String?    // preenchido quando entrada ocorre no contexto da oportunidade
  vendedorId    String
  dataHora      DateTime    @default(now())
  texto         String
  tipo          TipoFeed    @default(ANOTACAO)

  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  lead          Lead        @relation(fields: [leadId], references: [id])
  oportunidade  Oportunidade? @relation(fields: [oportunidadeId], references: [id])
  vendedor      Vendedor    @relation(fields: [vendedorId], references: [id])

  @@map("feed_leads")
}

enum TipoFeed {
  ANOTACAO
  MUDANCA_STATUS
  CONVERSAO
}

// ─── OPORTUNIDADES ────────────────────────────────────────────────────────────

model Oportunidade {
  id           String   @id @default(cuid())
  tenantId     String
  vendedorId   String
  clienteId    String
  tipoId       String?
  statusId     String?
  motivoEncerramentoId String?

  titulo       String
  temperatura  Int      @default(1) // 1-5, independente do lead
  valorEstimado Float?
  dataFechamentoPrevisto DateTime?
  observacoes  String?

  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  vendedor     Vendedor      @relation("OportunidadeVendedor", fields: [vendedorId], references: [id])
  cliente      Cliente       @relation(fields: [clienteId], references: [id])
  tipo         TipoOportunidade? @relation(fields: [tipoId], references: [id])
  status       StatusOportunidade? @relation(fields: [statusId], references: [id])
  motivoEncerramento MotivoEncerramento? @relation(fields: [motivoEncerramentoId], references: [id])

  leads        Lead[]
  feed         FeedLead[]
  cotacoes     Cotacao[]
  propostas    Proposta[]

  @@map("oportunidades")
}

// ─── COTAÇÕES ─────────────────────────────────────────────────────────────────

model Cotacao {
  id             String   @id @default(cuid())
  tenantId       String
  oportunidadeId String
  vendedorId     String
  numero         Int
  descricao      String?
  observacoes    String?
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  oportunidade   Oportunidade @relation(fields: [oportunidadeId], references: [id])
  vendedor       Vendedor     @relation(fields: [vendedorId], references: [id])
  itens          CotacaoItem[]

  @@map("cotacoes")
}

model CotacaoItem {
  id         String  @id @default(cuid())
  cotacaoId  String
  produtoId  String?
  descricao  String  // pode ser descrição livre ou do produto
  quantidade Float   @default(1)
  custoUnitario Float @default(0)
  observacoes String?

  cotacao    Cotacao  @relation(fields: [cotacaoId], references: [id], onDelete: Cascade)
  produto    Produto? @relation(fields: [produtoId], references: [id])
  fornecedores CotacaoItemFornecedor[]

  @@map("cotacao_itens")
}

model CotacaoItemFornecedor {
  id           String      @id @default(cuid())
  cotacaoItemId String
  fornecedorNome String
  preco        Float
  prazoEntrega Int?        // dias
  observacoes  String?

  cotacaoItem  CotacaoItem @relation(fields: [cotacaoItemId], references: [id], onDelete: Cascade)

  @@map("cotacao_item_fornecedores")
}

// ─── PROPOSTAS ────────────────────────────────────────────────────────────────

model Proposta {
  id             String        @id @default(cuid())
  tenantId       String
  oportunidadeId String
  vendedorId     String
  formaPagamentoId String?
  numero         Int
  descricao      String?
  validadeAte    DateTime?
  status         StatusProposta @default(RASCUNHO)
  observacoes    String?
  criadoEm      DateTime      @default(now())
  atualizadoEm  DateTime      @updatedAt

  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  oportunidade   Oportunidade  @relation(fields: [oportunidadeId], references: [id])
  vendedor       Vendedor      @relation(fields: [vendedorId], references: [id])
  formaPagamento FormaPagamento? @relation(fields: [formaPagamentoId], references: [id])
  itens          PropostaItem[]
  historico      PropostaHistorico[]
  pedidos        Pedido[]

  @@map("propostas")
}

enum StatusProposta {
  RASCUNHO
  ENVIADA
  APROVADA
  REPROVADA
  CANCELADA
}

model PropostaItem {
  id              String  @id @default(cuid())
  propostaId      String
  produtoId       String?
  descricao       String
  quantidade      Float   @default(1)
  custoUnitario   Float   @default(0)
  margemBrutaPct  Float   @default(20)
  indicePct       Float   @default(25)
  // calculados (salvos para histórico)
  precoVenda      Float   @default(0)
  margemBrutaRs   Float   @default(0)
  deducaoIndiceRs Float   @default(0)
  margemLiquidaRs Float   @default(0)
  comissaoPct     Float   @default(5)
  comissaoRs      Float   @default(0)
  resultadoLiq    Float   @default(0)

  proposta        Proposta  @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  produto         Produto?  @relation(fields: [produtoId], references: [id])

  @@map("proposta_itens")
}

model PropostaHistorico {
  id         String   @id @default(cuid())
  propostaId String
  status     StatusProposta
  observacao String?
  registradoEm DateTime @default(now())
  registradoPor String?

  proposta   Proposta @relation(fields: [propostaId], references: [id])

  @@map("proposta_historico")
}

// ─── PEDIDOS ──────────────────────────────────────────────────────────────────

model Pedido {
  id             String      @id @default(cuid())
  tenantId       String
  propostaId     String?
  vendedorId     String
  formaPagamentoId String?
  numeroPedido   Int
  status         StatusPedido @default(PENDENTE)
  valorTotal     Float       @default(0)
  observacoes    String?
  criadoEm      DateTime    @default(now())
  atualizadoEm  DateTime    @updatedAt

  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  proposta       Proposta?   @relation(fields: [propostaId], references: [id])
  vendedor       Vendedor    @relation(fields: [vendedorId], references: [id])
  formaPagamento FormaPagamento? @relation(fields: [formaPagamentoId], references: [id])
  parcelas       Parcela[]

  @@map("pedidos")
}

enum StatusPedido {
  PENDENTE
  FATURADO
  ENTREGUE
  CANCELADO
}

model Parcela {
  id         String        @id @default(cuid())
  pedidoId   String
  numero     Int
  valor      Float
  vencimento DateTime
  status     StatusParcela @default(PENDENTE)
  liquidacoes Liquidacao[]

  pedido     Pedido        @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@map("parcelas")
}

enum StatusParcela {
  PENDENTE
  RECEBIDO
  ATRASADO
}

model Liquidacao {
  id         String   @id @default(cuid())
  parcelaId  String
  valor      Float
  dataPagamento DateTime
  observacao String?
  registradoEm DateTime @default(now())

  parcela    Parcela  @relation(fields: [parcelaId], references: [id])

  @@map("liquidacoes")
}
